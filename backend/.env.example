# Copia este archivo como .env y ajusta los valores. No subas .env al repositorio.
NODE_ENV=development
PORT=4000

# Cadena de conexion a PostgreSQL. Cambia USUARIO y CONTRASENA por los de tu instalacion.
DATABASE_URL="postgresql://USUARIO:CONTRASENA@localhost:5432/caces_dev?schema=public"

# Secreto para firmar tokens de sesion. Usa un valor largo y aleatorio (minimo 32 caracteres).
JWT_SECRET="cambia-este-valor-por-uno-largo-y-aleatorio"
JWT_EXPIRES_IN=8h

# Origen permitido del frontend (CORS). Varios separados por coma.
CORS_ORIGINS=http://localhost:3000

# Almacenamiento de archivos: carpeta local persistente fuera del frontend.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
MAX_UPLOAD_MB=20

# Contrasena inicial de los usuarios creados por el seed (solo desarrollo).
SEED_DEFAULT_PASSWORD="CambiaEsta.2025"
# Solo produccion: el seed crea unicamente este administrador (clave minima 12 caracteres), sin usuarios de demostracion.
# SEED_ADMIN_EMAIL="admin@tu-institucion.edu.ec"

# Conexion para pruebas: cada "npm test" crea una base temporal caces_test_run_* y la elimina al terminar.
# El usuario necesita permiso CREATEDB. No se modifica ninguna base existente.
TEST_DATABASE_URL="postgresql://USUARIO:CONTRASENA@localhost:5432/caces_test?schema=public"
