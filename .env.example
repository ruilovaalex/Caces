# URL publica o local de la app.
VITE_APP_URL="http://localhost:3000"

# Nombre visible de la institucion.
VITE_INSTITUTION_NAME="Instituto Superior Tecnologico Sudamericano"

# Periodo activo de acreditacion.
VITE_ACCREDITATION_PERIOD="2025"

# URL del backend. Si se define, la app usa inicio de sesion real y datos compartidos
# en PostgreSQL. Si se deja vacia o se omite, funciona en modo local (datos solo en este navegador).
VITE_API_URL="http://localhost:4000"
